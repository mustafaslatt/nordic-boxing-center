# ─── Nordic Boxing Center ─────────────────────────────────────────────
# Kopier til .env og fyll inn. Tomme nøkler = simulert testmodus for den tjenesten.
# NODE_ENV=production nekter å starte hvis noen nøkler mangler.

PORT=5178
PUBLIC_URL=http://localhost:5178        # f.eks. https://www.nordicboxingcenter.no i produksjon
# NODE_ENV=production
# DB_FILE=data/nbc.sqlite
# CLUB_ORGNR=123 456 789                # vises i kontrakten

# Første administrator (opprettes ved første oppstart, passord kan byttes i admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── BankID (Criipto Verify) ─ https://dashboard.criipto.com
# Callback-URL som må registreres: {PUBLIC_URL}/auth/bankid/callback
CRIIPTO_DOMAIN=                         # f.eks. nordicboxing-test.criipto.id
CRIIPTO_CLIENT_ID=
CRIIPTO_CLIENT_SECRET=
# CRIIPTO_ACR=urn:grn:authn:no:bankid

# ─── Vipps MobilePay Recurring ─ https://portal.vippsmobilepay.com
VIPPS_ENV=test                          # test | prod
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=                              # Merchant Serial Number

# ─── Kort (Stripe) ─ https://dashboard.stripe.com/apikeys
# Webhook-endepunkt: {PUBLIC_URL}/webhooks/stripe
# Hendelser: checkout.session.completed, invoice.paid, invoice.payment_failed, customer.subscription.deleted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
